#!/usr/bin/env bash
# This is a fake gh for the tests. It records each call in $GH_CALLS (NNN.args, with
# one argument on each line, and NNN.stdin if the call reads stdin). It gives answers
# from environment variables that contain raw API responses. It applies a --jq/-q
# filter to the response with jq, as gh does. Thus, the tests also test the filters
# in the scripts.
set -euo pipefail

n=$(printf '%03d' $(( $(find "$GH_CALLS" -name '*.args' | wc -l) + 1 )))
printf '%s\n' "$@" > "$GH_CALLS/$n.args"
case " $* " in
  *"=@-"*|*" --input - "*|*" --body-file - "*) cat > "$GH_CALLS/$n.stdin" ;;
esac

filter=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "--jq" ] || [ "$prev" = "-q" ]; then filter=$arg; fi
  prev=$arg
done

respond() {
  if [ -n "$filter" ]; then jq -r "$filter" <<< "$1"; else printf '%s\n' "$1"; fi
}

no_threads='{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[]}}}}}'
no_comments='{"comments":[]}'

case " $* " in
  *resolveReviewThread*)
    [ -z "${GH_FAIL_RESOLVE:-}" ] || exit 1
    respond '{}' ;;
  *reviewThreads*)
    respond "${GH_THREADS_JSON:-$no_threads}" ;;
  *"/reviews "*)
    [ -z "${GH_FAIL_REVIEW:-}" ] || exit 1
    respond '{}' ;;
  *" PATCH "*|*" DELETE "*)
    respond '{}' ;;
  *"/issues/"*"/comments "*)
    respond "${GH_ISSUE_COMMENTS_JSON:-[]}" ;;
  *"/compare/"*)
    respond "${GH_COMPARE_DIFF:-}" ;;
  *" pr view "*)
    respond "${GH_PR_JSON:-$no_comments}" ;;
  *) ;;
esac
